# Etsy Seller App credentials from https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_keystring_here
ETSY_API_SECRET=your_shared_secret_here

# Filled by: npm run auth
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_TOKEN_EXPIRY=0
ETSY_SHOP_ID=

# OAuth callback for the local auth CLI (must match a Redirect URI on your Etsy app)
ETSY_REDIRECT_URI=http://localhost:8787/callback

# Scopes: read shop + create drafts + upload images. No extra write scopes.
ETSY_SCOPES=shops_r listings_r listings_w listings_d

# Protect the HTTP MCP endpoint Grok calls (Authorization: Bearer …)
MCP_AUTH_TOKEN=generate_a_long_random_secret

# HTTP server (Streamable HTTP for Grok custom connector)
PORT=3001
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-tunnel-or-host.example.com
